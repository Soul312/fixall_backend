# Copy to ".env" and fill in real values before running `docker compose up --build`.
# docker compose reads this file automatically. The Postgres credentials are
# already wired in docker-compose.yml, so only the secrets below are needed.

# --- JWT ---
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRY_MS=86400000

# --- Stripe (optional) ---
STRIPE_SECRET=
STRIPE_PUBLISHABLE=

# --- Firebase (optional) ---
FIREBASE_PROJECT_ID=

# --- Google Maps (optional) ---
GOOGLE_MAPS_KEY=
